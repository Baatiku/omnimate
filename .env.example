# Required: create at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Voice model for the presenter narration.
OMNIMATE_LIVE_MODEL=gemini-3.8-live

# Modal GPU workers.
# Presenter (photo -> talking video). Deploy: modal deploy modal/presenter.py
MODAL_PRESENTER_URL=
# Dubbing (YouTube link -> Hausa video). Deploy: modal deploy modal/dub.py
MODAL_DUB_URL=
# Optional: only needed if you protect the Modal endpoint with a bearer key.
MODAL_API_KEY=
# Video render timeout (high quality takes minutes on first cold start).
MODAL_TIMEOUT_MS=600000

# Quota governor. Applies PER MODEL. Defaults are conservative for a 5 RPM project.
OMNIMATE_GEMINI_RPM=5
OMNIMATE_GEMINI_RATE_SAFETY_MS=1000
OMNIMATE_GEMINI_MAX_RETRIES=3

HOST=127.0.0.1
PORT=8787
