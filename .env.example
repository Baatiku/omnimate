# Required: create at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Current defaults. Override only when you deliberately want another model.
OMNIMATE_TEXT_MODEL=gemini-3.8-flash
OMNIMATE_LIVE_MODEL=gemini-3.8-live

# Quota governor. Defaults are deliberately conservative for a 5 RPM project.
OMNIMATE_GEMINI_RPM=5
OMNIMATE_GEMINI_RATE_SAFETY_MS=1000
OMNIMATE_GEMINI_MAX_RETRIES=3

HOST=127.0.0.1
PORT=8787
